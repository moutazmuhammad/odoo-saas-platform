<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_saas" model="ir.module.category">
        <field name="name">SaaS</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_saas_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_saas"/>
        <field name="comment">Read-only access to SaaS instances.</field>
    </record>

    <record id="group_saas_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_saas"/>
        <field name="implied_ids" eval="[(4, ref('group_saas_user'))]"/>
        <field name="comment">Full management access to SaaS instances, servers, and configuration.</field>
    </record>

    <!-- SEC-005: deliberately NOT implied by/from group_saas_manager. Most
         manager-level work (billing, tenant lifecycle, viewing backups) has
         nothing to do with kubectl-exec access into tenant pods; bundling
         pod-shell access into the same broad role means any compromised or
         over-provisioned manager account can pivot into every tenant's
         running container, not just their own tooling. Grant this
         narrowly, on top of Manager, only to operators who genuinely need
         pod-exec access into the fleet. -->
    <record id="group_saas_pod_shell" model="res.groups">
        <field name="name">Pod Shell</field>
        <field name="category_id" ref="module_category_saas"/>
        <field name="comment">Grants kubectl-exec access into tenant pods (NOT the platform's own infrastructure — there is none reached over SSH anymore). Extremely sensitive: a member can reach every tenant's running container. Grant narrowly, separately from Manager.</field>
    </record>

    <!-- One-time-per-upgrade, idempotent: grandfather every EXISTING SaaS
         Manager into the new Pod Shell group, so introducing it doesn't
         silently revoke pod-exec access for whoever already had it via
         Manager before this change (SEC-005 fix). Placed outside the
         noupdate block below so it re-runs on every module upgrade,
         including the one that ships this change — new Manager grants
         from this point on do NOT automatically include Pod Shell. -->
    <function model="res.groups" name="_saas_grandfather_pod_shell_group" eval="[]"/>

    <!-- Record Rules -->
    <data noupdate="1">

        <!-- SaaS User: can only see instances of their own company -->
        <record id="rule_saas_instance_user_company" model="ir.rule">
            <field name="name">SaaS Instance: company-scoped (user)</field>
            <field name="model_id" ref="model_saas_instance"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_saas_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- SaaS Manager: can see and manage instances of their own company -->
        <record id="rule_saas_instance_manager_company" model="ir.rule">
            <field name="name">SaaS Instance: company-scoped (manager)</field>
            <field name="model_id" ref="model_saas_instance"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_saas_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Backup: inherits access from instance company -->
        <record id="rule_saas_backup_user_company" model="ir.rule">
            <field name="name">SaaS Backup: company-scoped (user)</field>
            <field name="model_id" ref="model_saas_instance_backup"/>
            <field name="domain_force">[('instance_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_saas_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_saas_backup_manager_company" model="ir.rule">
            <field name="name">SaaS Backup: company-scoped (manager)</field>
            <field name="model_id" ref="model_saas_instance_backup"/>
            <field name="domain_force">[('instance_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_saas_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Instance repos: inherits access from instance company -->
        <record id="rule_saas_instance_repo_user_company" model="ir.rule">
            <field name="name">SaaS Instance Repo: company-scoped (user)</field>
            <field name="model_id" ref="model_saas_instance_repo"/>
            <field name="domain_force">[('instance_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_saas_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_saas_instance_repo_manager_company" model="ir.rule">
            <field name="name">SaaS Instance Repo: company-scoped (manager)</field>
            <field name="model_id" ref="model_saas_instance_repo"/>
            <field name="domain_force">[('instance_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_saas_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Servers: company-scoped record rule for managers; users get
             no record-level access at all (the table has no user ACL,
             so this is defence in depth). Without this rule, a SaaS
             Manager in company A could see/edit company B's servers
             (and from there open an SSH terminal as root). -->
        <record id="rule_saas_server_manager_company" model="ir.rule">
            <field name="name">SaaS Server: company-scoped (manager)</field>
            <field name="model_id" ref="model_saas_server"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_saas_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>

</odoo>
