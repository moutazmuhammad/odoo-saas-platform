<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View (dialog) — no dedicated top-level menu, same as
         saas.ssh.key.pair: reached inline via the Many2one widget on
         saas.region's Kubernetes Cluster Connection group. -->
    <record id="saas_kubeconfig_view_form" model="ir.ui.view">
        <field name="name">saas.kubeconfig.form</field>
        <field name="model">saas.kubeconfig</field>
        <field name="arch" type="xml">
            <form string="Kubeconfig">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. EU Production Cluster"/>
                        </h1>
                    </div>
                    <group>
                        <field name="kubeconfig_loaded" readonly="1"/>
                        <field name="kubeconfig_file" filename="kubeconfig_file_name"
                               help="Upload to set/replace the kubeconfig. It is encrypted at rest and this box clears on save."/>
                        <field name="kubeconfig_file_name" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="saas_kubeconfig_view_list" model="ir.ui.view">
        <field name="name">saas.kubeconfig.list</field>
        <field name="model">saas.kubeconfig</field>
        <field name="arch" type="xml">
            <list string="Kubeconfigs">
                <field name="name"/>
                <field name="kubeconfig_loaded" widget="boolean_toggle" readonly="1"/>
            </list>
        </field>
    </record>

</odoo>
