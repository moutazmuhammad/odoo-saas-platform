<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The Kubernetes operator's own CronJob now DRIVES the actual
         nightly backup (pg_dump + filestore tar), once
         saas.instance._sync_scheduled_backup has patched spec.backup
         onto an instance's OdooInstance CR — this cron no longer does
         any backup work itself, just mirrors what landed in the bucket
         into saas.instance.backup records (pure S3/GCS listing, no
         Kubernetes exec) and reaps stale on-demand/stuck rows. Cheap
         enough to run far more often than the old once-daily restic
         cron. -->
    <record id="ir_cron_saas_backup" model="ir.cron">
        <field name="name">SaaS: Sync Scheduled Backups</field>
        <field name="model_id" ref="model_saas_instance_backup"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_scheduled_backups()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <!-- On-demand backups have a fixed 1-hour download window. After
         that, the bucket object is reaped and the local record removed
         so we don't accumulate orphans. 5-minute granularity is plenty:
         worst case a customer's expired link survives 5 extra minutes. -->
    <record id="ir_cron_saas_backup_ephemeral" model="ir.cron">
        <field name="name">SaaS: Reap Expired On-Demand Backups</field>
        <field name="model_id" ref="model_saas_instance_backup"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup_ephemeral_backups()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

</odoo>
