<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SaaS Manager
           Instances
           Catalog         Services, Odoo Versions (+ plans, tiers, add-ons,
                           support plans from saas_billing)
           Billing         (saas_billing)
           Configuration   Regions, Kubernetes Clusters, Base Domains, Settings -->

    <menuitem id="saas_master_menu_root"
              name="SaaS Manager"
              sequence="50"
              web_icon="saas_core,static/description/icon.png"
              groups="base.group_user"/>

    <!-- One list; hosting/service/state live in the search filters. -->
    <menuitem id="saas_master_menu_instances"
              name="Instances"
              parent="saas_master_menu_root"
              action="saas_instance_action"
              sequence="10"/>

    <menuitem id="saas_master_menu_catalog"
              name="Catalog"
              parent="saas_master_menu_root"
              sequence="15"/>

    <menuitem id="saas_master_menu_services"
              name="Services"
              parent="saas_master_menu_catalog"
              action="saas_product_action"
              sequence="10"/>

    <menuitem id="saas_master_menu_odoo_version"
              name="Odoo Versions"
              parent="saas_master_menu_catalog"
              action="saas_odoo_version_action"
              sequence="60"/>

    <menuitem id="saas_master_menu_configuration"
              name="Configuration"
              parent="saas_master_menu_root"
              sequence="90"/>

    <menuitem id="saas_master_menu_regions"
              name="Regions"
              parent="saas_master_menu_configuration"
              action="saas_region_action"
              sequence="10"/>

    <menuitem id="saas_master_menu_compute_kubernetes"
              name="Kubernetes Clusters"
              parent="saas_master_menu_configuration"
              action="saas_server_action"
              sequence="20"/>

    <menuitem id="saas_master_menu_based_domain"
              name="Base Domains"
              parent="saas_master_menu_configuration"
              action="saas_odoo_based_domain_action"
              sequence="30"/>

    <menuitem id="saas_master_menu_settings"
              name="Settings"
              parent="saas_master_menu_configuration"
              action="action_saas_master_config_settings"
              sequence="90"/>

</odoo>
