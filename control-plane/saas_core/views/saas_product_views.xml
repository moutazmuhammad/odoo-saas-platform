<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ List View ============ -->
    <record id="saas_product_view_list" model="ir.ui.view">
        <field name="name">saas.product.list</field>
        <field name="model">saas.product</field>
        <field name="arch" type="xml">
            <list string="SaaS Products">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_published"/>
                <field name="is_hosting"/>
                <field name="instance_count" string="Instances"/>
            </list>
        </field>
    </record>

    <!-- ============ Form View ============ -->
    <record id="saas_product_view_form" model="ir.ui.view">
        <field name="name">saas.product.form</field>
        <field name="model">saas.product</field>
        <field name="arch" type="xml">
            <form string="SaaS Product">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_instances" type="object"
                                class="oe_stat_button" icon="fa-server">
                            <field name="instance_count" widget="statinfo" string="Instances"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Odoo Hosting"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="is_published"/>
                            <field name="is_hosting"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ Action ============ -->
    <record id="saas_product_action" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">saas.product</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the hosting product
            </p>
            <p>
                The hosting product is created automatically on the first
                hosting order. Plans and projects are linked to it.
            </p>
        </field>
    </record>

</odoo>
