<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="saas_server_view_form" model="ir.ui.view">
        <field name="name">saas.server.form</field>
        <field name="model">saas.server</field>
        <field name="arch" type="xml">
            <form string="Compute Target">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. EU Kubernetes Cluster"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Deployment">
                            <field name="compute_driver"/>
                            <field name="region_id"
                                   options="{'no_create_edit': True}"/>
                        </group>
                        <group string="Network">
                            <field name="ip_v4"/>
                            <field name="private_ip_v4"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        This entry represents a <b>Kubernetes cluster</b>, not
                        a single machine — it exists so the cluster can be
                        allocated capacity and priced like any other compute
                        target. The cluster's actual connection (kubeconfig,
                        ingress address) is configured once on its
                        <b>Region</b>, since one region maps to exactly one
                        cluster — open the Region record above to view or
                        change it.
                    </div>
                    <group string="Health">
                        <group>
                            <field name="health_state"
                                   decoration-success="health_state == 'ok'"
                                   decoration-danger="health_state == 'unreachable'"
                                   widget="badge"/>
                            <field name="last_health_check"/>
                        </group>
                        <group>
                            <field name="last_health_error"
                                   invisible="health_state != 'unreachable'"/>
                        </group>
                    </group>
                    <group string="Capacity">
                        <group>
                            <field name="max_instances"/>
                            <field name="max_cpu_cores"/>
                            <field name="max_ram_gb"/>
                            <field name="allow_overcommit"/>
                        </group>
                        <group>
                            <field name="instance_count"/>
                            <field name="allocated_cpu"/>
                            <field name="allocated_ram_gb"/>
                        </group>
                    </group>
                    <group string="Cost model (per-tenant margin) &amp; immutable images">
                        <group string="Infra cost rate card (per month)">
                            <field name="cost_per_cpu_month"/>
                            <field name="cost_per_gb_ram_month"/>
                            <field name="cost_per_gb_storage_month"/>
                            <field name="monthly_cost"/>
                        </group>
                        <group string="Phase 2 (disposable compute)">
                            <field name="object_filestore_mount"/>
                            <field name="registry_host"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="saas_server_view_list" model="ir.ui.view">
        <field name="name">saas.server.list</field>
        <field name="model">saas.server</field>
        <field name="arch" type="xml">
            <list string="Compute">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="region_id" optional="show"/>
                <field name="ip_v4" optional="show"/>
                <field name="private_ip_v4" optional="hide"/>
                <field name="health_state" widget="badge"
                       decoration-success="health_state == 'ok'"
                       decoration-danger="health_state == 'unreachable'"/>
                <field name="instance_count" string="Instances" optional="show"/>
                <field name="max_instances" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="saas_server_view_search" model="ir.ui.view">
        <field name="name">saas.server.search</field>
        <field name="model">saas.server</field>
        <field name="arch" type="xml">
            <search string="Search Compute">
                <field name="name"/>
                <field name="ip_v4"/>
                <field name="region_id"/>
                <separator/>
                <filter string="Region" name="group_region"
                        context="{'group_by': 'region_id'}"/>
            </search>
        </field>
    </record>

    <record id="saas_server_action" model="ir.actions.act_window">
        <field name="name">Kubernetes Clusters</field>
        <field name="res_model">saas.server</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="saas_server_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Kubernetes clusters registered yet
            </p>
            <p>One entry per managed Kubernetes cluster (any provider — EKS,
               GKE, AKS, self-hosted...). Create the entry here for capacity/
               pricing, then configure its actual connection (kubeconfig,
               ingress address) on the matching Region — one region maps to
               one cluster.</p>
        </field>
    </record>

</odoo>
