<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="saas_server_view_form" model="ir.ui.view">
        <field name="name">saas.server.form</field>
        <field name="model">saas.server</field>
        <field name="arch" type="xml">
            <form string="Kubernetes Cluster">
                <header>
                    <button name="action_open_terminal" string="Terminal"
                            type="object" icon="fa-terminal"
                            groups="saas_core.group_saas_cluster_shell"
                            invisible="not kubeconfig_loaded"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. EU Kubernetes Cluster"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="region_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="kubeconfig_loaded" readonly="1"/>
                            <field name="kubeconfig_file" filename="kubeconfig_file_name"/>
                            <field name="kubeconfig_file_name" invisible="1"/>
                            <field name="tls_cluster_issuer"/>
                        </group>
                        <group string="Network">
                            <field name="ip_v4"/>
                            <field name="private_ip_v4"/>
                        </group>
                    </group>
                    <group string="Health">
                        <group>
                            <field name="health_state"
                                   decoration-success="health_state == 'ok'"
                                   decoration-danger="health_state == 'unreachable'"
                                   widget="badge"/>
                            <field name="last_health_check"/>
                        </group>
                        <group>
                            <field name="last_health_error"
                                   invisible="health_state != 'unreachable'"/>
                        </group>
                    </group>
                    <group string="Capacity">
                        <group>
                            <field name="max_instances"/>
                            <field name="max_cpu_cores"/>
                            <field name="max_ram_gb"/>
                            <field name="allow_overcommit"/>
                        </group>
                        <group>
                            <field name="instance_count"/>
                            <field name="allocated_cpu"/>
                            <field name="allocated_ram_gb"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Image Builds" name="image_builds">
                            <p class="text-muted">
                                Needed if customers deploy their own Git
                                repositories on this cluster. Registry
                                credentials are also used to pull every
                                tenant, build and toolbox image, so the
                                platform images can live in a private registry.
                            </p>
                            <group>
                                <group>
                                    <field name="registry_host"
                                           placeholder="e.g. ghcr.io or localhost:32000"/>
                                    <field name="registry_push_host"
                                           placeholder="only if the build pushes elsewhere"/>
                                    <field name="registry_prefix" placeholder="e.g. my-org/odoo-tenants"/>
                                    <field name="registry_username"/>
                                    <field name="registry_password" password="True"/>
                                </group>
                                <group>
                                    <field name="registry_insecure"/>
                                    <field name="builder_image"/>
                                    <field name="git_image"/>
                                    <field name="toolbox_image"/>
                                </group>
                            </group>
                        </page>
                        <page string="Monitoring" name="monitoring">
                            <group>
                                <field name="prometheus_namespace" placeholder="e.g. monitoring"/>
                                <field name="prometheus_service" placeholder="e.g. prometheus-server:80"/>
                            </group>
                        </page>
                        <page string="Cost" name="cost">
                            <group>
                                <group string="Cost per month">
                                    <field name="cost_per_cpu_month"/>
                                    <field name="cost_per_gb_ram_month"/>
                                    <field name="cost_per_gb_storage_month"/>
                                    <field name="monthly_cost"/>
                                </group>
                                <group>
                                    <field name="object_filestore_mount"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="saas_server_view_list" model="ir.ui.view">
        <field name="name">saas.server.list</field>
        <field name="model">saas.server</field>
        <field name="arch" type="xml">
            <list string="Kubernetes Clusters">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="region_id" optional="show"/>
                <field name="kubeconfig_loaded" string="Connected" optional="show"/>
                <field name="ip_v4" optional="show"/>
                <field name="private_ip_v4" optional="hide"/>
                <field name="health_state" widget="badge"
                       decoration-success="health_state == 'ok'"
                       decoration-danger="health_state == 'unreachable'"/>
                <field name="instance_count" string="Instances" optional="show"/>
                <field name="max_instances" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="saas_server_view_search" model="ir.ui.view">
        <field name="name">saas.server.search</field>
        <field name="model">saas.server</field>
        <field name="arch" type="xml">
            <search string="Search Clusters">
                <field name="name"/>
                <field name="ip_v4"/>
                <field name="region_id"/>
                <separator/>
                <filter string="Region" name="group_region"
                        context="{'group_by': 'region_id'}"/>
            </search>
        </field>
    </record>

    <record id="saas_server_action" model="ir.actions.act_window">
        <field name="name">Kubernetes Clusters</field>
        <field name="res_model">saas.server</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="saas_server_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Kubernetes clusters registered yet
            </p>
            <p>One entry per Kubernetes cluster: upload its kubeconfig and
               pick its region. A region can have several clusters; new
               instances go to the least-loaded healthy one.</p>
        </field>
    </record>

</odoo>
