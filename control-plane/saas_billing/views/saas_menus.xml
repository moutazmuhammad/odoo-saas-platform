<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Billing (A1/A4) — top-level menu moved here from saas_core along
         with the wallet/payment models. References saas_core's root menu
         as parent (allowed: saas_billing depends on saas_core). -->
    <menuitem id="saas_master_menu_billing"
              name="Billing"
              parent="saas_core.saas_master_menu_root"
              sequence="20"/>
    <!-- Commercial catalog config — moved here from Infrastructure/
         Configuration (billing/pricing architecture redesign, Part 6/9):
         these are pricing/plan decisions the owner makes, not
         infrastructure config, so they belong alongside the rest of
         Billing rather than mixed in with Servers/Regions/Domains. -->
    <menuitem id="saas_master_menu_plans"
              name="Plans"
              parent="saas_master_menu_billing"
              action="saas_core.saas_plan_action"
              sequence="5"/>
    <menuitem id="saas_master_menu_compute_tiers"
              name="Compute Tiers"
              parent="saas_master_menu_billing"
              action="saas_core.saas_compute_tier_action"
              sequence="7"/>
    <menuitem id="saas_master_menu_addons"
              name="Add-ons"
              parent="saas_master_menu_billing"
              action="saas_addon_action"
              sequence="8"/>
    <menuitem id="saas_master_menu_support_plans"
              name="Support Plans"
              parent="saas_master_menu_billing"
              action="saas_support_plan_action"
              sequence="9"/>
    <!-- Tenant Margins/Profitability: the action stays defined in
         saas_core (views/saas_margin_views.xml, still saas.instance-
         scoped) and is ALSO the promoted Dashboard menu item at the app
         root — kept here too so it's reachable from Billing directly. -->
    <menuitem id="saas_master_menu_margins"
              name="Profitability"
              parent="saas_master_menu_billing"
              action="saas_core.action_saas_tenant_margins"
              sequence="35"/>
    <menuitem id="saas_master_menu_wallets"
              name="Customer Wallets"
              parent="saas_master_menu_billing"
              action="saas_wallet_action"
              sequence="40"/>
    <menuitem id="saas_master_menu_payment_methods"
              name="Saved Payment Methods"
              parent="saas_master_menu_billing"
              action="saas_payment_method_action"
              sequence="50"/>
    <menuitem id="saas_master_menu_payment_attempts"
              name="Payment Attempts"
              parent="saas_master_menu_billing"
              action="saas_payment_attempt_action"
              sequence="60"/>
    <menuitem id="saas_master_menu_payment_routing"
              name="Payment Provider Routing"
              parent="saas_master_menu_billing"
              action="saas_payment_provider_config_action"
              sequence="70"/>

</odoo>
