<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="saas_region_action" model="ir.actions.act_window">
        <field name="name">Regions</field>
        <field name="res_model">saas.region</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a region</p>
            <p>A region is a location customers pick at checkout. Add its
               Kubernetes clusters under Configuration &gt; Kubernetes
               Clusters; new instances go to the least-loaded healthy one.</p>
        </field>
    </record>

    <record id="saas_region_view_list" model="ir.ui.view">
        <field name="name">saas.region.list</field>
        <field name="model">saas.region</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="price_multiplier"/>
                <field name="is_recommended"/>
                <field name="is_default"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="saas_region_view_form" model="ir.ui.view">
        <field name="name">saas.region.form</field>
        <field name="model">saas.region</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="is_recommended"/>
                            <field name="is_default"/>
                            <field name="active"/>
                        </group>
                        <group string="Pricing">
                            <field name="price_multiplier"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <separator string="Clusters"/>
                    <field name="server_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="instance_count" string="Instances"/>
                            <field name="health_state" widget="badge"
                                   decoration-success="health_state == 'ok'"
                                   decoration-danger="health_state == 'unreachable'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
